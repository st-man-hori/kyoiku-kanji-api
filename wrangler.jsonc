{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyoiku-kanji-api",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kyoiku-kanji-db",
      "database_id": "21ed98be-b55c-4843-ae39-cfaea39ced90",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}